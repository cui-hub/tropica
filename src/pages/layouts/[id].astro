---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FavoriteButton from '@/components/FavoriteButton.astro';
import {
  chineseName,
  imagePath,
  layoutDetails,
  layoutSlug,
  plantDetailByCode,
  plantSlug,
  sitePath,
  techniqueLabels,
  type LayoutDetailItem
} from '@/lib/catalog';

interface Props { layout: LayoutDetailItem; }

export const getStaticPaths = (() => layoutDetails.map((layout) => ({
  params: { id: layoutSlug(layout.layout_code) },
  props: { layout }
}))) satisfies GetStaticPaths;

const { layout } = Astro.props;
const sourceUrl = `https://tropica.com${layout.detail_path}`;
const techniques = Object.entries(layout.technique_cn).filter(([, value]) => value);
const rawDescription = layout.descriptions_cn[0] || `${layout.name_cn}水草造景案例`;
const description = `${layout.name_cn}（${layout.layout_code}）水草缸造景案例，包含 ${layout.plants.length} 种植物的清单、种植位置、设备配置与维护方法。${rawDescription}`.slice(0, 160);
const canonicalUrl = new URL(sitePath(`layouts/${layoutSlug(layout.layout_code)}/`), Astro.site).href;
const homeUrl = new URL(sitePath(''), Astro.site).href;
const layoutsUrl = new URL(sitePath('layouts/'), Astro.site).href;
const coverImage = imagePath(layout.local_images[0]);
const coverImageUrl = new URL(coverImage, Astro.site).href;
const structuredData = [
  {
    '@type': 'CreativeWork',
    '@id': `${canonicalUrl}#aquascape`,
    name: layout.name_cn,
    alternateName: layout.name,
    identifier: layout.layout_code,
    description: rawDescription,
    url: canonicalUrl,
    image: coverImageUrl,
    inLanguage: 'zh-CN',
    creator: layout.designers.map((name) => ({ '@type': 'Person', name })),
    about: layout.plants.map((plant) => ({ '@type': 'Thing', name: plant.name, identifier: plant.product_code }))
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: '造景灵感', item: layoutsUrl },
      { '@type': 'ListItem', position: 3, name: layout.name_cn, item: canonicalUrl }
    ]
  }
];
---

<BaseLayout
  title={`${layout.name_cn}｜${layout.layout_code} 水草缸造景案例`}
  description={description}
  image={coverImage}
  imageAlt={`${layout.name_cn}水草缸造景`}
  structuredData={structuredData}
>
  <section class="detail-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="面包屑">
        <a href={sitePath('')}>首页</a><span>/</span><a href={sitePath('layouts/')}>造景灵感</a><span>/</span><span>{layout.name_cn}</span>
      </nav>
      <div class="detail-hero-grid">
        <div class="detail-cover">
          <img src={imagePath(layout.local_images[0])} alt={layout.name_cn} fetchpriority="high" />
        </div>
        <div class="detail-intro">
          <p class="eyebrow">{layout.layout_code} · {layout.difficulty_cn}</p>
          <h1>{layout.name_cn}</h1>
          <p class="latin-name">{layout.name}</p>
          <div class="chip-row">
            <span class="chip">{layout.technique_cn.volume || '容积待补'}</span>
            <span class="chip muted">{layout.plants.length} 种植物</span>
            <span class="chip muted">每周 {layout.technique_cn.maintenance_hours_per_week || '维护时间待补'}</span>
          </div>
          <p class="card-summary">设计：{layout.designers.join(' / ') || '未署名'}</p>
          <div class="detail-actions">
            <FavoriteButton itemKey={`layout:${layoutSlug(layout.layout_code)}`} />
            {layout.pdf && <a class="text-link" href={layout.pdf} target="_blank" rel="noreferrer">查看原始造景指南 ↗</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section compact">
    <div class="shell content-grid">
      <article class="prose">
        <h2>设计思路</h2>
        {layout.descriptions_cn.length ? layout.descriptions_cn.map((paragraph) => <p>{paragraph}</p>) : <p>这份造景的中文介绍仍在整理中。</p>}
        <div class="source-box">
          造景资料与图片来源于 Tropica Aquarium Plants；图片署名归原造景师所有。<a href={sourceUrl} target="_blank" rel="noreferrer">查看原始页面 ↗</a>
        </div>
      </article>
      <aside class="side-panel">
        <h2>设备与维护</h2>
        <dl>
          {techniques.map(([key, value]) => <div><dt>{techniqueLabels[key] || key}</dt><dd>{value}</dd></div>)}
        </dl>
      </aside>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="shell content-grid">
      <div>
        <div class="section-heading"><div><p class="eyebrow">Planting list</p><h2>植物清单</h2></div></div>
        <div class="plant-list">
          {layout.plants.map((item) => {
            const detail = plantDetailByCode.get(item.product_code);
            return detail ? (
              <a class="plant-list-item" href={sitePath(`plants/${plantSlug(item.product_code)}/`)}>
                <span class="plant-position">{item.position || '·'}</span>
                <span><strong>{chineseName(detail)}</strong><small>{item.name}</small></span>
                <span class="plant-quantity">× {item.quantity}</span>
              </a>
            ) : (
              <div class="plant-list-item">
                <span class="plant-position">{item.position || '·'}</span>
                <span><strong>{item.name}</strong><small>{item.product_code}</small></span>
                <span class="plant-quantity">× {item.quantity}</span>
              </div>
            );
          })}
        </div>
      </div>
      {layout.local_planting_plan && (
        <div class="planting-plan-column">
          <div class="section-heading"><div><p class="eyebrow">Planting plan</p><h2>种植位置</h2></div></div>
          <figure class="planting-plan">
            <button
              class="planting-plan-trigger"
              type="button"
              data-image-preview-open
              aria-label={`预览${layout.name_cn}种植位置大图`}
            >
              <img src={imagePath(layout.local_planting_plan)} alt={`${layout.name_cn}种植位置示意图`} loading="lazy" />
              <span class="image-preview-hint" aria-hidden="true">查看大图 ↗</span>
            </button>
          </figure>
          <dialog class="image-preview" data-image-preview aria-label={`${layout.name_cn}种植位置大图`}>
            <div class="image-preview-inner">
              <button class="image-preview-close" type="button" data-image-preview-close aria-label="关闭大图预览">×</button>
              <div class="image-preview-stage">
                <img src={imagePath(layout.local_planting_plan)} alt={`${layout.name_cn}种植位置大图`} loading="lazy" />
              </div>
              <p>{layout.name_cn} · 种植位置</p>
            </div>
          </dialog>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Aquascape gallery</p><h2>造景过程与细节</h2></div></div>
      <div class="gallery-grid">
        {layout.local_images.map((image, index) => <figure><img src={imagePath(image)} alt={`${layout.name_cn}造景图片 ${index + 1}`} loading={index < 2 ? 'eager' : 'lazy'} /></figure>)}
      </div>
    </div>
  </section>

  <script>
    const preview = document.querySelector<HTMLDialogElement>('[data-image-preview]');
    const openPreview = document.querySelector<HTMLButtonElement>('[data-image-preview-open]');
    const closePreview = document.querySelector<HTMLButtonElement>('[data-image-preview-close]');

    function closeImagePreview() {
      preview?.close();
      document.body.classList.remove('preview-open');
    }

    openPreview?.addEventListener('click', () => {
      preview?.showModal();
      document.body.classList.add('preview-open');
    });
    closePreview?.addEventListener('click', closeImagePreview);
    preview?.addEventListener('cancel', () => document.body.classList.remove('preview-open'));
    preview?.addEventListener('click', (event) => {
      if (event.target === preview) closeImagePreview();
    });
  </script>
</BaseLayout>
