---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LayoutCard from '@/components/LayoutCard.astro';
import PlantCard from '@/components/PlantCard.astro';
import { layoutDetails, plantList } from '@/lib/catalog';
---

<BaseLayout title="我的收藏" description="保存在当前设备上的水草和造景收藏。">
  <header class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <p class="eyebrow">Saved locally</p>
        <h1>我的收藏</h1>
        <p>收藏保存在当前浏览器中，不需要登录，也不会上传到服务器。</p>
      </div>
      <span class="result-count" id="favorite-count" aria-live="polite">0 项</span>
    </div>
  </header>

  <section class="section compact">
    <div class="shell favorite-catalog" id="favorite-catalog">
      <div class="catalog-grid">
        {plantList.map((plant) => <PlantCard plant={plant} favoriteContext />)}
        {layoutDetails.map((layout) => <LayoutCard layout={layout} favoriteContext />)}
      </div>
      <div class="empty-state visible" id="favorite-empty">
        <h2>还没有收藏</h2>
        <p>在水草或造景卡片上点击心形按钮，稍后从这里继续查看。</p>
      </div>
    </div>
  </section>

  <script>
    const storageKey = 'aquatic-wiki:favorites:v1';
    const items = [...document.querySelectorAll<HTMLElement>('[data-favorite-item]')];
    const count = document.querySelector<HTMLElement>('#favorite-count')!;
    const empty = document.querySelector<HTMLElement>('#favorite-empty')!;
    function renderFavorites() {
      let favorites: string[] = [];
      try { favorites = JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch { favorites = []; }
      const selected = new Set(favorites);
      let visible = 0;
      for (const item of items) {
        const show = selected.has(item.dataset.favoriteItem || '');
        item.classList.toggle('favorite-visible', show);
        if (show) visible += 1;
      }
      count.textContent = `${visible} 项`;
      empty.classList.toggle('visible', visible === 0);
    }
    document.addEventListener('aquatic:favorites', renderFavorites);
    renderFavorites();
  </script>
</BaseLayout>
