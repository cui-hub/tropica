---
import '../styles/global.css';
import LogoMark from '@/components/LogoMark.astro';
import { featuredLayouts, imagePath, sitePath } from '@/lib/catalog';

type JsonLdNode = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  pageType?: 'WebPage' | 'CollectionPage';
  noindex?: boolean;
  structuredData?: JsonLdNode | JsonLdNode[];
}

const {
  title = 'Aqualore｜水草百科与造景灵感',
  description = '查询水草习性、养护条件和真实造景案例。',
  image,
  imageAlt = 'Aqualore 水草百科与水草缸造景灵感',
  pageType = 'WebPage',
  noindex = false,
  structuredData = []
} = Astro.props;
const pathname = Astro.url.pathname;
const fullTitle = title.includes('Aqualore') ? title : `${title}｜Aqualore`;
const canonicalUrl = new URL(pathname, Astro.site);
const homeUrl = new URL(sitePath(''), Astro.site);
const sitemapUrl = new URL(sitePath('sitemap-index.xml'), Astro.site);
const defaultImage = featuredLayouts[0]?.local_images[0] ? imagePath(featuredLayouts[0].local_images[0]) : sitePath('favicon.svg');
const socialImageUrl = new URL(image || defaultImage, Astro.site);
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeUrl.href}#website`,
      url: homeUrl.href,
      name: 'Aqualore',
      alternateName: 'Aqualore 水草百科',
      description: '面向水草缸爱好者的水草百科、养护资料与造景案例索引。',
      inLanguage: 'zh-CN'
    },
    {
      '@type': pageType,
      '@id': `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: fullTitle,
      description,
      inLanguage: 'zh-CN',
      isPartOf: { '@id': `${homeUrl.href}#website` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: socialImageUrl.href
      }
    },
    ...extraStructuredData
  ]
};
const serializedJsonLd = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const nav = [
  { label: '首页', href: sitePath('') },
  { label: '水草百科', href: sitePath('plants/') },
  { label: '造景灵感', href: sitePath('layouts/') },
  { label: '收藏', href: sitePath('favorites/') }
];
const isActive = (href: string) => href === sitePath('') ? pathname === href : pathname.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#f7f8f5" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aqualore" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={serializedJsonLd} />
    <script is:inline>
      window._hmt = window._hmt || [];
      (function () {
        var hm = document.createElement('script');
        hm.src = 'https://hm.baidu.com/hm.js?2c814ae3eba059b5b02508992f15b9d4';
        hm.async = true;
        document.head.appendChild(hm);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={sitePath('')} aria-label="Aqualore 首页">
          <LogoMark />
          <strong>Aqualore</strong>
        </a>
        <nav class="desktop-nav" aria-label="主导航">
          {nav.map((item) => (
            <a class:list={{ active: isActive(item.href) }} href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <a class="footer-brand" href={sitePath('')}><LogoMark /><strong>Aqualore</strong></a>
          <p>为水草爱好者整理的植物与造景索引。</p>
        </div>
        <p class="source-note">
          数据、原始文本与图片来源：<a href="https://tropica.com/" target="_blank" rel="noreferrer">Tropica Aquarium Plants</a>。本站为资料整理与学习用途。
        </p>
      </div>
    </footer>

    <nav class="mobile-nav" aria-label="移动端导航">
      {nav.map((item) => (
        <a class:list={{ active: isActive(item.href) }} href={item.href}>{item.label}</a>
      ))}
    </nav>
    <script>
      import '../scripts/favorites';
      import '../scripts/resilient-images';
    </script>
  </body>
</html>
